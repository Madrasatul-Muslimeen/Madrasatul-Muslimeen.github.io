rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Issue #206 -- CANDIDATE Rules for the whole-Qur'an/Juz running word
    // counter (quranWordTotals).
    //
    // STATUS: CANDIDATE. NOT DEPLOYED. NOT MERGED INTO firestore.rules.
    // Deploying Rules is an Owner Control Gate (CLAUDE.md's own standing
    // rule); this file exists so the shape can be reasoned about before
    // anyone is asked to approve it. app/js/study-wbw-total-readiness.js
    // gates the app so nothing here is even attempted against production
    // until that governed decision is made and this candidate is actually
    // deployed.
    //
    // This is a SELF-CONTAINED extract, the same convention
    // tests/firestore/word-progress-v1.proposed.rules already uses: it
    // carries only the helpers this one collection needs, reproduced from
    // the deployed rules unchanged, so it can be reasoned about (and, in a
    // future round, run against the emulator) in isolation. It must never
    // be deployed as a replacement for the whole production file.
    //
    // WHY ONE DOCUMENT PER PERSON, NOT PER (PERSON, JUZ). The running total
    // is a small, bounded aggregate -- one `known` integer and one `byJuz`
    // map of exactly 30 `{known, total}` pairs -- the same "one small
    // document, additive, no query" shape activity/{tenantId}__{personId}__
    // {weekKey} and quranWordTotals' own sibling collections already use.
    // Nothing here is queried by anything other than its own document id
    // (tenantId + '__' + personId), so there is no list-safety proof to
    // make and no composite index to declare.
    //
    // WHO MAY WRITE IT: exactly canRecordFor()'s existing set (self, an
    // active co-enrolled teacher, a guardian, or tenant/platform admin) --
    // reproduced unchanged from the deployed rules, the SAME authority the
    // deployed quranWordProgress/quranWordApprovals rules already grant for
    // word progress. This round invents no new authority idea.
    //
    // WHAT IS DELIBERATELY NOT ENFORCED HERE, stated rather than hidden:
    // the per-Juz SHAPE (that a given juz's `known` never exceeds its own
    // `total`, that `known` values only ever move by the amount a real
    // countsAsKnown transition produces) is validated client-side, in
    // app/js/quran-word-total.js and app/js/quran-word-total-data.js --
    // the same accepted trust boundary quranWordProgress's own per-entry
    // state codes already rely on (this file's own comment there says so).
    // A Firestore rule cannot cheaply recompute "is this delta the delta an
    // honest client would have produced" without re-deriving the whole
    // progress model server-side, which this candidate does not attempt.
    // =====================================================================

    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }

    function tenantPersonRef(personId) { return /databases/$(database)/documents/tenantPeople/$(personId); }
    function memberUidRef(tenantId)    { return /databases/$(database)/documents/tenantMemberUids/$(tenantId + '__' + myUid()); }
    function teacherStudentLinkRef(tenantId, teacherPersonId, studentPersonId) {
      return /databases/$(database)/documents/teacherStudentLinks/$(tenantId + '__' + teacherPersonId + '__' + studentPersonId);
    }

    function hasRoleIn(tenantId, role) {
      return signedIn() && exists(memberUidRef(tenantId))
          && role in get(memberUidRef(tenantId)).data.get('roles', []);
    }
    function myPersonIdIn(tenantId) {
      return signedIn() && exists(memberUidRef(tenantId))
           ? get(memberUidRef(tenantId)).data.get('personId', null) : null;
    }
    function isPlatformAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/userIndex/$(myUid()))
          && get(/databases/$(database)/documents/userIndex/$(myUid())).data.get('platformAdmin', false) == true;
    }
    function isOwnerIn(tenantId)    { return hasRoleIn(tenantId, 'owner'); }
    function isPrimeIn(tenantId)    { return hasRoleIn(tenantId, 'prime'); }
    function isTeacherIn(tenantId)  { return hasRoleIn(tenantId, 'teacher'); }
    function isGuardianIn(tenantId) { return hasRoleIn(tenantId, 'guardian'); }
    function canAdminIdentity(tenantId) { return isOwnerIn(tenantId) || isPrimeIn(tenantId) || isPlatformAdmin(); }
    function isGuardianOf(tenantId, childPersonId) {
      return isGuardianIn(tenantId)
          && exists(tenantPersonRef(childPersonId))
          && get(tenantPersonRef(childPersonId)).data.get('managedByPersonId', null) == myPersonIdIn(tenantId);
    }
    function isCoEnrolledTeacherOf(tenantId, studentPersonId) {
      return signedIn() && myPersonIdIn(tenantId) != null
          && exists(teacherStudentLinkRef(tenantId, myPersonIdIn(tenantId), studentPersonId))
          && get(teacherStudentLinkRef(tenantId, myPersonIdIn(tenantId), studentPersonId)).data.get('active', false) == true;
    }
    function isSelfPerson(personId) {
      return signedIn() && exists(tenantPersonRef(personId))
          && get(tenantPersonRef(personId)).data.get('authUid', null) == myUid();
    }

    // Reproduced UNCHANGED from the deployed rules (the same function the
    // quranWordProgress candidate above it already copies verbatim).
    function canRecordFor(tenantId, personId) {
      return canAdminIdentity(tenantId)
          || (isTeacherIn(tenantId) && isCoEnrolledTeacherOf(tenantId, personId))
          || isGuardianOf(tenantId, personId)
          || isSelfPerson(personId);
    }

    // Identity fields are write-once, the same reasoning
    // wordLaneIdentityUnchanged() already applies to quranWordProgress:
    // a valid writer for THIS person must never be able to repoint the
    // document at another tenant or person.
    function wordTotalIdentityUnchanged() {
      return resource != null
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.personId == resource.data.personId
          && request.resource.data.total    == resource.data.total;
    }

    // A created document must say what it is and must already carry the
    // real whole-Qur'an total -- never a value a client invented.
    function isWordTotalCreate() {
      return request.resource.data.get('contractVersion', '') == 'quran-word-total:v1'
          && request.resource.data.get('total', 0) == 77429
          && request.resource.data.known is int && request.resource.data.known >= 0
          && request.resource.data.byJuz is map;
    }

    // total_key/{tenantId}__{personId}
    match /quranWordTotals/{totalsKey} {
      allow read: if isPlatformAdmin();
      // S8-class allowance the deployed quranWordProgress rule already
      // makes: the client reads this document before deciding create-vs-
      // update, and a nonexistent document has no data to expose.
      allow read: if signedIn() && !exists(/databases/$(database)/documents/quranWordTotals/$(totalsKey));
      allow read: if canRecordFor(resource.data.tenantId, resource.data.personId);

      allow create: if canRecordFor(request.resource.data.tenantId, request.resource.data.personId)
                    && isWordTotalCreate();
      // Only `known`, `byJuz` (its per-juz `known` sub-fields) and the
      // envelope's own `updatedAt` may move on update -- never `total`,
      // never the identity fields, never a whole-document overwrite.
      allow update: if resource != null
                    && canRecordFor(resource.data.tenantId, resource.data.personId)
                    && wordTotalIdentityUnchanged()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['known', 'byJuz', 'updatedAt']);
      // No delete (I4/D6). The counter only ever moves; it is never reset.
    }
  }
}
