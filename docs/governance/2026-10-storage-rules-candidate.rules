// CANDIDATE -- NOT DEPLOYED, and not referenced by firebase.json. The Owner publishes this themselves (Firebase console ->
// Storage -> Rules), guided click by click, after switching the project to the Blaze plan (decision 81).
// Pictures in Notes (Part C, item 35; issue #620). Bucket: study-monitoring.firebasestorage.app
//
//  * PRIVATE: only the signed-in person can read or write their own folder, noteImages/{their uid}/.
//    Sharing a picture with family or teachers is a later decision and is NOT in this file.
//  * CREATE only: no update and no delete (D6, I4). A picture, once saved, is never changed or removed by the app.
//  * What may be created: a file named {8-40 letters, digits, _ or -}.webp, of type image/webp, at most 400 KB
//    (the app makes every picture about 200 KB first, on the device). "At most 400 KB" matches the app's own ceiling exactly (Architect review: it read "< 400 KB", so a picture of exactly 400 KB passed the app and was refused here).
//  * Everything else in the bucket is denied.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /noteImages/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // `resource == null`: only a NEW file. Architect review, measured in the Storage emulator: without it, an upload
      // to an EXISTING picture's name was allowed as a create, i.e. a picture could be overwritten (D6 forbids that).
      allow create: if request.auth != null && request.auth.uid == uid
                    && resource == null
                    && request.resource.size <= 400 * 1024
                    && request.resource.contentType == 'image/webp'
                    && file.matches('[A-Za-z0-9_-]{8,40}[.]webp');
      // no update, no delete
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
