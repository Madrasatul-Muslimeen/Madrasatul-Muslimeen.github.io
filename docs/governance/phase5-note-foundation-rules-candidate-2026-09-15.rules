rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // MAP Phase 5 — CANDIDATE Rules for the Note Foundation.
    //
    // STATUS: CANDIDATE. NOT DEPLOYED. NOT MERGED INTO firestore.rules.
    // Deploying Rules is an Owner Control Gate.
    //
    // SELF-CONTAINED EXTRACT: only the helpers these three collections need,
    // reproduced unchanged from the deployed rules so the emulator can run it
    // in isolation. It must never be deployed as a whole file.
    //
    // GOVERNS EXACTLY THREE COLLECTIONS: notes, noteRevisions, noteSources.
    //
    // noteFolders and notePlacements are DELIBERATELY ABSENT. They belong to
    // MAP Phase 6 (Mapping My Journey), the data layer that writes them is
    // uninvoked, and an unruled collection is denied by default — so leaving
    // them out is the safe answer, not an omission. Matrix cases REL-02,
    // REL-03 and REL-04 are Phase 6 and are therefore out of this candidate's
    // scope rather than silently skipped.
    //
    // ---------------------------------------------------------------------
    // THE SECURITY DESIGN, and the one thing it deliberately does not do yet
    // ---------------------------------------------------------------------
    //
    // The accepted matrix names the canonical owner as `ownerPersonId`, with
    // `ownerUid` nullable because a managed child may have no login at all.
    // Everything follows from that:
    //
    //   * ONLY THE OWNER WRITES. Not a guardian, not a teacher, not a tenant
    //     administrator, not a platform administrator. Every other role that
    //     can see a Note can only ever READ it. That is stricter than
    //     canRecordFor(), which is used across the rest of this app for
    //     progress data — a Note is a person's own private writing, not a
    //     record kept about them.
    //   * A guardian is a CUSTODIAN, not an owner (matrix: "custodian-and-
    //     actor-not-owner"): scoped read of a linked child, nothing more.
    //   * A teacher reads only an ACTIVELY linked student's Notes.
    //   * An administrator reads only inside their own tenant.
    //   * Revisions are create-only for ever. Identity fields are frozen.
    //     Nothing is ever deleted (I4/D6).
    //
    // NOT IMPLEMENTED HERE, and stated rather than hidden: matrix cases
    // GUARD-05/06/07 describe a 30-minute, server-expiring, Note-specific
    // approval that would let a guardian make a content revision for a
    // managed child. **No such approval mechanism exists** — the accepted
    // data layer has no approval document and no expiry concept. Rather than
    // invent one inside a Rules candidate, this ruleset DENIES every guardian
    // content edit outright. That satisfies GUARD-04, GUARD-06, GUARD-07 and
    // GUARD-08 in full and is strictly safer than the accepted design; only
    // the single ALLOW case GUARD-05 is unreachable, and it stays a recorded
    // dependency on the approval mechanism being designed.
    //
    // ---------------------------------------------------------------------
    // COST IS A SECURITY PROPERTY (the P4-B finding, applied here from the
    // start): no rule below walks a map, counts entries, or inspects a
    // dynamic key. Every rule costs a fixed handful of get()/exists() calls
    // regardless of how many Notes a person has written, because document
    // SIZE and COLLECTION SIZE never enter a rule.
    // =====================================================================

    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }

    function tenantPersonRef(personId) { return /databases/$(database)/documents/tenantPeople/$(personId); }
    function memberUidRef(tenantId)    { return /databases/$(database)/documents/tenantMemberUids/$(tenantId + '__' + myUid()); }
    function teacherStudentLinkRef(tenantId, teacherPersonId, studentPersonId) {
      return /databases/$(database)/documents/teacherStudentLinks/$(tenantId + '__' + teacherPersonId + '__' + studentPersonId);
    }

    function hasRoleIn(tenantId, role) {
      return signedIn() && exists(memberUidRef(tenantId))
          && role in get(memberUidRef(tenantId)).data.get('roles', []);
    }
    function myPersonIdIn(tenantId) {
      return signedIn() && exists(memberUidRef(tenantId))
           ? get(memberUidRef(tenantId)).data.get('personId', null) : null;
    }
    function isPlatformAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/userIndex/$(myUid()))
          && get(/databases/$(database)/documents/userIndex/$(myUid())).data.get('platformAdmin', false) == true;
    }
    function isOwnerIn(tenantId)    { return hasRoleIn(tenantId, 'owner'); }
    function isPrimeIn(tenantId)    { return hasRoleIn(tenantId, 'prime'); }
    function isTeacherIn(tenantId)  { return hasRoleIn(tenantId, 'teacher'); }
    function isGuardianIn(tenantId) { return hasRoleIn(tenantId, 'guardian'); }

    function isSelfPerson(personId) {
      return signedIn() && exists(tenantPersonRef(personId))
          && get(tenantPersonRef(personId)).data.get('authUid', null) == myUid();
    }
    function isGuardianOf(tenantId, childPersonId) {
      return isGuardianIn(tenantId)
          && exists(tenantPersonRef(childPersonId))
          && get(tenantPersonRef(childPersonId)).data.get('managedByPersonId', null) == myPersonIdIn(tenantId);
    }
    function isCoEnrolledTeacherOf(tenantId, studentPersonId) {
      return signedIn() && myPersonIdIn(tenantId) != null
          && exists(teacherStudentLinkRef(tenantId, myPersonIdIn(tenantId), studentPersonId))
          && get(teacherStudentLinkRef(tenantId, myPersonIdIn(tenantId), studentPersonId)).data.get('active', false) == true;
    }

    // The person must really belong to the tenant the document names.
    // isSelfPerson() proves "this login owns that person" but NOT "that person
    // is in this tenant" — the same cross-tenant gap the Phase 4 candidate
    // closed, closed here too (matrix SELF-05, ADMIN-02).
    function personInTenant(tenantId, personId) {
      return exists(tenantPersonRef(personId))
          && get(tenantPersonRef(personId)).data.get('tenantId', null) == tenantId;
    }

    // WHO MAY READ a Note that belongs to `ownerPersonId` in `tenantId`.
    // Administrators are tenant-scoped on purpose: a platform administrator
    // gets no unbounded cross-tenant reach here (ADMIN-04).
    function canReadNoteOf(tenantId, ownerPersonId) {
      return signedIn()
          && personInTenant(tenantId, ownerPersonId)
          && (isSelfPerson(ownerPersonId)
              || isGuardianOf(tenantId, ownerPersonId)
              || (isTeacherIn(tenantId) && isCoEnrolledTeacherOf(tenantId, ownerPersonId))
              || isOwnerIn(tenantId) || isPrimeIn(tenantId));
    }

    // WHO MAY WRITE. Only the owner, and only their own. Deliberately NOT
    // canRecordFor(): a guardian, teacher or administrator may read a Note
    // and may never author or alter one (GUARD-04, TEACH-04, ADMIN-03).
    function isNoteOwner(tenantId, ownerPersonId) {
      return signedIn()
          && personInTenant(tenantId, ownerPersonId)
          && isSelfPerson(ownerPersonId);
    }

    // LIST vs GET (matrix QUERY-01/QUERY-02). Firestore Rules cannot inspect a
    // query's `where` clauses, so "the query must be scoped" is enforced the
    // only way it can be: the per-document rule below must hold for EVERY
    // document the query would return, so an unscoped list over the collection
    // fails as soon as it touches a Note the caller may not read. What Rules
    // CAN see is the limit, and an unbounded list is refused outright — the
    // accepted data layer always passes one (`maximum = 100`), so this costs
    // the real client nothing and stops a scan of the whole collection.
    function listIsBounded() {
      return request.query.limit <= 100;
    }

    function d() { return request.resource.data; }

    // Ownership block, written identically on every Foundation document.
    function ownershipWellFormed() {
      return d().tenantId is string && d().tenantId.size() > 0
          && d().ownerPersonId is string && d().ownerPersonId.size() > 0
          && (d().get('ownerUid', null) == null || d().ownerUid is string);
    }

    // Identity and origin are WRITE-ONCE (IMM-01). A valid writer may change
    // what a Note SAYS; nobody may repoint it at another tenant, another
    // person, or another origin — which is what would let a legitimate writer
    // smuggle a write into someone else's data.
    // `resource != null` is not decoration: Firestore evaluates every matching
    // allow clause, so a create also runs the update clause where `resource`
    // is null and a field read on it throws. Guarding it keeps every denial a
    // decision the rules made rather than an exception they tripped over.
    function noteIdentityUnchanged() {
      return resource != null
          && d().tenantId       == resource.data.tenantId
          && d().ownerPersonId  == resource.data.ownerPersonId
          && d().get('ownerUid', null) == resource.data.get('ownerUid', null)
          && d().noteId         == resource.data.noteId
          && d().visibility     == resource.data.visibility;
    }

    // -------------------------------------------------------------------
    // notes/{noteKey}   noteKey = tenantId__noteId
    // -------------------------------------------------------------------
    match /notes/{noteKey} {

      function noteShapeOk() {
        return d().keys().hasOnly([
                 'noteId', 'tenantId', 'ownerPersonId', 'ownerUid', 'visibility',
                 'title', 'bodyHtml', 'status', 'currentRevisionId',
                 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
               ])
            && d().keys().hasAll([
                 'noteId', 'tenantId', 'ownerPersonId', 'visibility',
                 'title', 'bodyHtml', 'status', 'currentRevisionId',
                 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
               ])
            && ownershipWellFormed()
            && d().noteId is string && d().noteId.size() > 0
            && noteKey == d().tenantId + '__' + d().noteId
            && d().visibility == 'private'
            && d().title is string && d().bodyHtml is string
            && (d().status == 'active' || d().status == 'retired')
            && d().currentRevisionId is string && d().currentRevisionId.size() > 0;
      }

      // createdBy records WHO FIRST WROTE the document and is an origin fact,
      // so it is stamped on create and frozen thereafter — never re-checked
      // against whoever is updating.
      //
      // Found by mutation testing: an earlier version required
      // `createdBy == myUid()` on BOTH paths, which conflated authorship with
      // authorisation. It happened to deny a teacher's update — but for the
      // wrong reason, and it meant the owner check on the update path was never
      // exercised at all (neutralising isNoteOwner left the suite green). It
      // would also have refused a legitimate future path where someone other
      // than the original creator may edit. Authorisation is isNoteOwner()'s
      // job, and only its job.
      function createdByStampedOnCreate() { return d().createdBy == myUid(); }
      function createdByFrozen() { return resource != null && d().createdBy == resource.data.createdBy; }

      // THE ATOMICITY RULE (matrix TXN-01/TXN-02), and the reason getAfter()
      // is used rather than trusted prose: a Note's currentRevisionId must
      // name a revision that EXISTS once this commit lands, belongs to this
      // same Note, tenant and owner, and — on an update — chains from the
      // revision the Note is moving away from. Rules evaluate each document
      // independently, so without getAfter() a client could point a Note at a
      // revision it never wrote, and the pointer would be fiction.
      function revisionRef(revisionId) {
        return /databases/$(database)/documents/noteRevisions/$(d().tenantId + '__' + revisionId);
      }
      function committedRevisionMatches(previousRevisionId) {
        return existsAfter(revisionRef(d().currentRevisionId))
            && getAfter(revisionRef(d().currentRevisionId)).data.noteId == d().noteId
            && getAfter(revisionRef(d().currentRevisionId)).data.tenantId == d().tenantId
            && getAfter(revisionRef(d().currentRevisionId)).data.ownerPersonId == d().ownerPersonId
            && getAfter(revisionRef(d().currentRevisionId)).data.get('previousRevisionId', null) == previousRevisionId;
      }

      allow get: if canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);
      allow list: if listIsBounded() && canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);

      allow create: if noteShapeOk()
                    && createdByStampedOnCreate()
                    && isNoteOwner(d().tenantId, d().ownerPersonId)
                    && d().status == 'active'
                    && committedRevisionMatches(null);

      // An update may change the title, the body, the status and the revision
      // pointer — and nothing else. A stale pointer is refused because the new
      // revision must chain from the CURRENT one (matrix TXN-03).
      allow update: if resource != null
                    && noteShapeOk()
                    && createdByFrozen()
                    && isNoteOwner(resource.data.tenantId, resource.data.ownerPersonId)
                    && noteIdentityUnchanged()
                    && committedRevisionMatches(resource.data.currentRevisionId);

      allow delete: if false; // I4/D6, matrix IMM-03. Retiring writes a status.
    }

    // -------------------------------------------------------------------
    // noteRevisions/{revisionKey}   revisionKey = tenantId__revisionId
    // Append-only history. Created once, never touched again (IMM-02).
    // -------------------------------------------------------------------
    match /noteRevisions/{revisionKey} {

      allow get: if canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);
      allow list: if listIsBounded() && canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);

      allow create: if d().keys().hasOnly([
                         'revisionId', 'noteId', 'tenantId', 'ownerPersonId', 'ownerUid',
                         'previousRevisionId', 'title', 'bodyHtml', 'revisionReason', 'actorUid',
                         'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
                       ])
                    && d().keys().hasAll([
                         'revisionId', 'noteId', 'tenantId', 'ownerPersonId',
                         'previousRevisionId', 'title', 'bodyHtml', 'revisionReason', 'actorUid',
                         'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
                       ])
                    && ownershipWellFormed()
                    && d().revisionId is string && d().revisionId.size() > 0
                    && revisionKey == d().tenantId + '__' + d().revisionId
                    && d().noteId is string && d().noteId.size() > 0
                    && (d().previousRevisionId == null || d().previousRevisionId is string)
                    && d().title is string && d().bodyHtml is string
                    && d().revisionReason is string && d().revisionReason.size() > 0
                    && d().actorUid == myUid()
                    && d().createdBy == myUid()
                    && isNoteOwner(d().tenantId, d().ownerPersonId);

      // NEVER. History that can be edited is not history (IMM-02, IMM-03).
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // noteSources/{sourceLinkKey}   the origin/reference/resource link
    // -------------------------------------------------------------------
    match /noteSources/{sourceLinkKey} {

      allow get: if canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);
      allow list: if listIsBounded() && canReadNoteOf(resource.data.tenantId, resource.data.ownerPersonId);

      allow create: if d().keys().hasOnly([
                         'sourceLinkId', 'noteId', 'tenantId', 'ownerPersonId', 'ownerUid',
                         'sourceKind', 'sourceKey', 'relationshipKind', 'approachId',
                         'provenanceKind', 'status',
                         'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
                       ])
                    && d().keys().hasAll([
                         'sourceLinkId', 'noteId', 'tenantId', 'ownerPersonId',
                         'sourceKind', 'sourceKey', 'relationshipKind',
                         'provenanceKind', 'status',
                         'schemaVersion', 'createdAt', 'updatedAt', 'createdBy'
                       ])
                    && ownershipWellFormed()
                    && d().sourceLinkId is string && d().sourceLinkId.size() > 0
                    && sourceLinkKey == d().tenantId + '__' + d().sourceLinkId
                    && d().noteId is string && d().noteId.size() > 0
                    && d().sourceKind is string && d().sourceKind.size() > 0
                    && d().sourceKey is string && d().sourceKey.size() > 0
                    && d().relationshipKind is string && d().relationshipKind.size() > 0
                    && d().provenanceKind is string && d().provenanceKind.size() > 0
                    && (d().get('approachId', null) == null || d().approachId is string)
                    && (d().status == 'active' || d().status == 'retired')
                    && d().createdBy == myUid()
                    && isNoteOwner(d().tenantId, d().ownerPersonId)
                    // REL-01: the link must belong to a Note that is really
                    // this owner's, in this tenant. Without this a valid
                    // writer could attach their own source link to somebody
                    // else's Note and make it appear in that person's origins.
                    && exists(/databases/$(database)/documents/notes/$(d().tenantId + '__' + d().noteId))
                    && get(/databases/$(database)/documents/notes/$(d().tenantId + '__' + d().noteId)).data.ownerPersonId == d().ownerPersonId;

      // A link may be retired, never repointed and never deleted.
      allow update: if resource != null
                    && isNoteOwner(resource.data.tenantId, resource.data.ownerPersonId)
                    && d().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && (d().status == 'active' || d().status == 'retired');

      allow delete: if false;
    }
  }
}
