{
  "status": "implementation-authorised-contract",
  "foundationCollections": [
    "notes",
    "noteSources",
    "noteFolders",
    "notePlacements",
    "noteRevisions"
  ],
  "deferredCollections": [
    "noteImportBatches",
    "noteImportItems",
    "noteDerivedLinks"
  ],
  "identity": {
    "noteId": "opaque-stable-non-derived",
    "studyUnitKeyUse": "source-reference-only",
    "folderPlacement": "many-to-many-relation"
  },
  "access": {
    "self": {
      "scope": "same-auth-linked-tenant-person",
      "read": "automatic",
      "edit": "automatic"
    },
    "guardian": {
      "scope": "linked-managed-child-only",
      "read": "automatic",
      "edit": "per-note-guardian-approval"
    },
    "teacher": {
      "scope": "active-linked-student-only",
      "read": "automatic",
      "edit": "no-automatic-authority"
    },
    "tenantAdministrator": {
      "scope": "authorised-tenant-only",
      "read": "automatic",
      "edit": "no-automatic-authority"
    },
    "platformAdministrator": {
      "scope": "authorised-platform-role",
      "read": "automatic",
      "edit": "no-automatic-authority"
    },
    "managedChildWithoutLogin": {
      "scope": "guardian-session-selected-child",
      "read": "view-only-by-default",
      "edit": "per-note-guardian-approval"
    },
    "managedChildApproval": {
      "durationMinutes": 30,
      "clock": "server-enforced",
      "scope": "one-note-one-guardian-one-child-one-tenant",
      "renewal": "guardian-quick-approval",
      "earlyTermination": "revocation-or-context-exit-where-enforceable",
      "coverage": "title-body-and-atomic-revision-only"
    }
  },
  "legacyCompatibility": {
    "ayahNotesUnchanged": true,
    "dualWrite": false,
    "automaticMigration": false,
    "userControlledCopyWithProvenance": true
  },
  "revisionDirection": "immutable-full-snapshot-measure-before-implementation",
  "implementationAuthorised": true,
  "rulesModificationAuthorised": true,
  "deploymentAuthorised": false
}
